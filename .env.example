# All credentials are optional unless you use the corresponding provider.
# Keep this file empty in version control. Put real values in environment
# variables or a local `.env` file that is ignored by Git.

# Optional: dedicated Semantic Scholar quota.
SEMANTIC_SCHOLAR_API_KEY=

# Required only for Scopus tools. Access may also depend on subscription or IP.
ELSEVIER_API_KEY=

# Optional institutional token for eligible Scopus subscriptions.
ELSEVIER_INST_TOKEN=

# Required only for experimental Google Scholar discovery through SerpAPI.
SERPAPI_API_KEY=
